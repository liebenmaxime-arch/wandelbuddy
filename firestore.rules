rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Oude versie (oude link met de testdata): ongewijzigd =====
    match /{col}/{id} {
      allow read: if col in ['activities', 'joins', 'users', 'views', 'events', 'config'];
      allow create, update: if col in ['activities', 'joins', 'users', 'views', 'events', 'config'];
      allow delete: if col in ['activities', 'joins'];
    }

    // ===== Nieuwe versie: elk bedrijf in een eigen map =====
    function ingelogd() { return request.auth != null; }
    function lidVan(c) { return ingelogd() && exists(/databases/$(database)/documents/companies/$(c)/auth/$(request.auth.uid)); }

    match /companies/{c} {
      // de lijst met bedrijfsnamen (voor de voorstellen bij het aanmelden)
      allow read: if ingelogd();
      allow create: if ingelogd()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow update, delete: if false;

      // "dit toestel hoort bij dit bedrijf": elk toestel mag alleen zijn eigen kaartje maken
      match /auth/{uid} {
        allow read, create, update: if ingelogd() && request.auth.uid == uid;
        allow delete: if false;
      }

      // alle gegevens van het bedrijf: alleen voor wie bij dat bedrijf hoort
      match /{sub}/{id} {
        allow read, write: if lidVan(c) && sub in ['activities', 'joins', 'users', 'views', 'events', 'config'];
      }
    }
  }
}
